#!/usr/bin/env sh
set -eu

# Never allow added/modified environment files to be committed.
staged_paths="$(git diff --cached --name-only --diff-filter=ACMR)"
blocked_env_files="$(
  echo "$staged_paths" \
  | grep -E '(^|/)\.env($|\.|/)|(^|/).*\.env$' \
  | grep -Ev '(^|/)\.env\.example$|(^|/)\.env\.sample$' || true
)"

if [ -n "${blocked_env_files}" ]; then
  echo "ERROR: Refusing commit because env files are staged:"
  echo "${blocked_env_files}"
  echo "Keep secrets local and commit only .env.example."
  exit 1
fi

# Scan staged added lines for common API key/token patterns.
if git diff --cached -U0 | grep -E '^\+.*(AIza[0-9A-Za-z_-]{20,}|sk-[0-9A-Za-z_-]{20,}|xox[baprs]-[0-9A-Za-z-]{10,}|gh[pousr]_[0-9A-Za-z]{20,})' >/dev/null 2>&1; then
  echo "ERROR: Refusing commit because a secret-like token pattern was detected."
  echo "Remove secrets from staged changes before committing."
  exit 1
fi

exit 0
